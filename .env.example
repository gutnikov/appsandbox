# Публичный адрес платформы (без завершающего слэша)
PUBLIC_BASE_URL=http://localhost:5173

# GitHub OAuth App данного окружения
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/github/callback

# Шаблон, из которого порождаются сэндбоксы
TEMPLATE_REPO=gutnikov/sandbox-template

# Postgres (Neon)
DATABASE_URL=

# Ключ подписи сессионных значений
SESSION_SECRET=

# Реестр образов сэндбоксов
REGISTRY_HOST=registry.zerotomvp.xyz
REGISTRY_TOKEN_KID=zerotomvp-registry-1
REGISTRY_TOKEN_KEY=

# Порт HTTP-сервера
PORT=3000

# Внутренний пароль платформы к реестру (только чтение)
REGISTRY_PULL_SECRET=
