#!/usr/bin/env bash
# Kamal без Ruby: официальный образ с примонтированным проектом.
#
# Образ получает ключ выката, поэтому он закреплён по digest, а не по тегу:
# `latest` означал бы, что любое обновление наверху получает наш ключ.
# Docker-сокет не пробрасывается: образ платформы собирается в GitHub
# Actions, и `deploy --skip-push` локальная сборка не нужна. Если всё же
# нужна — KAMAL_WITH_DOCKER=1, осознанно.
set -euo pipefail

KAMAL_IMAGE_DIGEST="${KAMAL_IMAGE_DIGEST:-sha256:7b5be276aa17bbe122887f6a1ff12865f4848111989699b9786083be95d98415}"

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KEY="${KAMAL_SSH_KEY:-$HOME/.ssh/zerotomvp_deploy}"
HOST="$(awk '/^ *- [0-9]/{gsub(/[- ]/,"");print;exit}' "$ROOT/config/deploy.yml")"

# Каталог обязан лежать там, где Docker Desktop делится файлами: каталог из
# mktemp на macOS попадает в /var/folders, который внутрь не пробрасывается.
SSH_DIR="$(mktemp -d "$HOME/.cache/zerotomvp-kamal-XXXXXX")"
trap 'rm -rf "$SSH_DIR"' EXIT

install -m 600 "$KEY" "$SSH_DIR/$(basename "$KEY")"

# Ключ хоста берём из уже доверенного known_hosts, а не сканируем заново:
# свежий ssh-keyscan доверяет тому, что вернула сеть.
if ssh-keygen -F "$HOST" -f "$HOME/.ssh/known_hosts" > "$SSH_DIR/known_hosts" 2>/dev/null &&
   [ -s "$SSH_DIR/known_hosts" ]; then
  # Записи без хеширования: Net::SSH внутри Kamal не сопоставляет хешированные.
  ssh-keygen -F "$HOST" -f "$HOME/.ssh/known_hosts" 2>/dev/null |
    grep -v '^#' > "$SSH_DIR/known_hosts"
else
  echo "Хоста $HOST нет в ~/.ssh/known_hosts." >&2
  echo "Подключитесь к нему обычным ssh и проверьте отпечаток, потом повторите." >&2
  exit 1
fi
chmod 600 "$SSH_DIR/known_hosts"

docker_mount=()
if [ "${KAMAL_WITH_DOCKER:-}" = "1" ]; then
  docker_mount=(-v /var/run/docker.sock:/var/run/docker.sock)
fi

exec docker run --rm -i \
  -v "$ROOT:/workdir" \
  -v "$SSH_DIR:/root/.ssh" \
  ${docker_mount[@]+"${docker_mount[@]}"} \
  -e KAMAL_REGISTRY_PASSWORD \
  -e DATABASE_URL \
  -e SESSION_SECRET \
  -e GITHUB_CLIENT_SECRET \
  -e REGISTRY_TOKEN_KEY \
  -e REGISTRY_PULL_SECRET \
  -e REGISTRY_EVENTS_SECRET \
  "ghcr.io/basecamp/kamal@$KAMAL_IMAGE_DIGEST" "$@"
